FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    $moving_wall
    {
        type        fixedValue;
        value       uniform $lid_velocity;
    }
    $fixed_walls
    {
        type        fixedValue;
        value       uniform (0 0 0);
    }
    $front_and_back
    {
        type        empty;
    }
}
