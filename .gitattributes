* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh text eol=lf
.githooks/* text eol=lf

# Release asset smoke fixtures contain checksum-sensitive bytes. Keep Git from
# normalizing line endings so local and CI hash verification use the same bytes.
tests/fixtures/release_assets/** -text

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mat binary
*.stl binary
*.step binary
*.stp binary
*.iges binary
*.igs binary
