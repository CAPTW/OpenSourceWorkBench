#!/usr/bin/env sh
set -eu

if command -v py >/dev/null 2>&1 && py -3 -c "import sys" >/dev/null 2>&1; then
  py -3 tools/git/check_merge_gate.py --hook pre-merge-commit
elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
  python tools/git/check_merge_gate.py --hook pre-merge-commit
elif command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
  python3 tools/git/check_merge_gate.py --hook pre-merge-commit
else
  echo "OSW pre-merge-commit: Python 3 is required." >&2
  exit 2
fi
